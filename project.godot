; Engine configuration file.
config_version=5

[application]

config/name="Crewdown Realm"
config/description="Wi-Fi multiplayer first-person PvP shooter on The Skeld."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

Settings="*res://scripts/settings.gd"
Sfx="*res://scripts/sfx.gd"
Net="*res://scripts/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[gui]

theme/custom_font="res://fonts/DejaVuSans.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"

[physics]

common/physics_ticks_per_second=60
common/physics_jitter_fix=0.0
3d/physics_engine="Godot Physics"

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
limits/opengl/max_renderable_lights=32
limits/opengl/max_lights_per_object=8
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
